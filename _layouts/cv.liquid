---
layout: default
---
{% assign cv_feature_enabled = site.al_folio.features.cv.enabled | default: true %}

{% if site.plugins contains 'al_folio_cv' and cv_feature_enabled %}
  <style>
    .cv .list-group > .list-group-item::marker {
      content: '';
    }

    .cv .list-group-item > .row:has(> .date-column) {
      display: grid;
      grid-template-columns: max-content minmax(0, 1fr);
      align-items: start;
      gap: 0.5rem 1rem;
      margin-inline: 0;
    }

    .cv .list-group-item > .row:has(> .date-column) > div {
      width: auto;
      max-width: none;
      padding-inline: 0;
    }

    .cv .date-column {
      transform: none;
      justify-self: start;
    }

    @media (max-width: 760px) {
      .cv .list-group-item > .row:has(> .date-column) {
        grid-template-columns: minmax(0, 1fr);
      }
    }
  </style>
  {% al_folio_cv_render %}
{% else %}
  <div class="post">
    <header class="post-header">
      <h1 class="post-title">{{ page.title }}</h1>
      <p class="post-description">CV rendering is unavailable.</p>
    </header>
    <article>
      <p>Enable the <code>al_folio_cv</code> plugin and set <code>al_folio.features.cv.enabled: true</code> to render this page.</p>
    </article>
  </div>
{% endif %}
